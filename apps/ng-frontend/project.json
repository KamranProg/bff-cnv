{
  "name": "ng-frontend",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/ng-frontend/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/ng-frontend",
        "browser": "apps/ng-frontend/src/main.ts",
        "polyfills": ["zone.js"],
        "tsConfig": "apps/ng-frontend/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/ng-frontend/public"
          }
        ],
        "styles": ["apps/ng-frontend/src/styles.scss"]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
               "type": "initial",
               "maximumWarning": "500kb",
               "maximumError": "1mb"
            },
            {
               "type": "anyComponentStyle",
               "maximumWarning": "4kb",
               "maximumError": "8kb"
            }
          ],
          "outputHashing": "all",
          "fileReplacements": [
            {
              "replace": "apps/ng-frontend/src/environments/environment.ts",
              "with": "apps/ng-frontend/src/environments/environment.prod.ts"
            }
          ]
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "options": {
        "proxyConfig": "proxy.conf.json"
      },
      "configurations": {
        "production": {
          "buildTarget": "ng-frontend:build:production"
        },
        "development": {
          "buildTarget": "ng-frontend:build:development",
          "proxyConfig": "proxy.conf.json"
        }
      },
      "defaultConfiguration": "development"
    },
    "extract-i18n": {
      "executor": "@angular/build:extract-i18n",
      "options": {
        "buildTarget": "ng-frontend:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/ng-frontend/jest.config.ts",
        "tsConfig": "apps/ng-frontend/tsconfig.spec.json"
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "ng-frontend:build",
        "port": 4200,
        "staticFilePath": "dist/apps/ng-frontend/browser",
        "spa": true
      }
    }
  }
}
